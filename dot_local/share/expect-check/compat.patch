diff --git a/packages/agent/src/acp-operation-guard.ts b/packages/agent/src/acp-operation-guard.ts
new file mode 100644
index 00000000..d6adfaf5
--- /dev/null
+++ b/packages/agent/src/acp-operation-guard.ts
@@ -0,0 +1,60 @@
+/** Bounds the handshake and rejects every pending operation when its adapter exits. */
+export class AcpOperationGuard {
+  private pending = new Set<(error: Error) => void>();
+  private exitError: Error | undefined;
+  private diagnostics = "";
+
+  stderr(line: string): void {
+    this.diagnostics = `${this.diagnostics}${line}\n`.slice(-16384);
+  }
+
+  exited(code: number): Error {
+    const error =
+      this.exitError ??
+      new Error(
+        `ACP adapter exited with status ${code}${this.diagnostics ? `\n${this.diagnostics.trimEnd()}` : ""}`,
+      );
+    this.exitError = error;
+    for (const reject of this.pending) reject(error);
+    return error;
+  }
+
+  run<T>(name: string, operation: () => Promise<T>, timeoutMs = 30000): Promise<T> {
+    if (this.exitError) return Promise.reject(this.exitError);
+    return new Promise<T>((resolve, reject) => {
+      const fail = (error: Error) => {
+        cleanup();
+        reject(error);
+      };
+      const timer =
+        timeoutMs > 0
+          ? setTimeout(
+              () =>
+                fail(
+                  new Error(
+                    `${name} timed out after ${timeoutMs} milliseconds${this.diagnostics ? `\n${this.diagnostics.trimEnd()}` : ""}`,
+                  ),
+                ),
+              timeoutMs,
+            )
+          : undefined;
+      const cleanup = () => {
+        clearTimeout(timer);
+        this.pending.delete(fail);
+      };
+      this.pending.add(fail);
+      Promise.resolve()
+        .then(operation)
+        .then(
+          (value) => {
+            cleanup();
+            resolve(value);
+          },
+          (error) => {
+            cleanup();
+            reject(error);
+          },
+        );
+    });
+  }
+}
diff --git a/packages/agent/tests/acp-operation-guard.test.ts b/packages/agent/tests/acp-operation-guard.test.ts
new file mode 100644
index 00000000..758abab0
--- /dev/null
+++ b/packages/agent/tests/acp-operation-guard.test.ts
@@ -0,0 +1,30 @@
+import { describe, expect, it } from "vite-plus/test";
+import { AcpOperationGuard } from "../src/acp-operation-guard";
+
+describe("ACP pending operations", () => {
+  it("preserves protocol handshake failures", async () => {
+    const guard = new AcpOperationGuard();
+    await expect(
+      guard.run("ACP initialization", () => Promise.reject(new Error("invalid protocol"))),
+    ).rejects.toThrow("invalid protocol");
+  });
+  it("rejects all pending operations and future calls on early exit with stderr", async () => {
+    const guard = new AcpOperationGuard();
+    const cause = "config.toml:6:16: unknown variant `default`, expected `fast` or `flex`";
+    guard.stderr(cause);
+    const first = guard.run("ACP initialization", () => new Promise(() => {}));
+    const second = guard.run("ACP session creation", () => new Promise(() => {}));
+    guard.exited(7);
+    await expect(first).rejects.toThrow(cause);
+    await expect(second).rejects.toThrow("status 7");
+    await expect(guard.run("late", async () => 1)).rejects.toThrow(cause);
+  });
+  it("bounds a silent handshake and retains diagnostic context", async () => {
+    const guard = new AcpOperationGuard();
+    guard.stderr("adapter starting");
+    await expect(guard.run("ACP initialization", () => new Promise(() => {}), 20)).rejects.toThrow(
+      "ACP initialization timed out after 20 milliseconds\nadapter starting",
+    );
+    expect(await guard.run("healthy", async () => 42, 20)).toBe(42);
+  });
+});
