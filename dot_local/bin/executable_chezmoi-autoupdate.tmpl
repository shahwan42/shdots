#!/bin/sh
# Keep the fleet converged without touching shell startup: run from launchd
# (mac) / a systemd user timer (vm), auto-apply only when it is provably safe,
# and otherwise leave a marker that zshrc surfaces as a one-line warning.
#
# Safe to auto-apply means: source clone has no local edits AND origin is a
# strict fast-forward ahead. Anything else (divergence, dirty tree, failed
# apply) writes ~/.cache/chezmoi-stale with the reason and leaves the human
# in the loop. Never modifies a diverged clone. The marker is cleared only
# when $HOME provably matches the source (chezmoi status empty), not merely
# when the clone is up to date.
set -u
{{ if not (includeTemplate "has-autoupdate" .) -}}
# Notify only: never merge, apply, or refresh externals on disabled accounts.
mkdir -p "$HOME/.cache"
HEALTH="$HOME/.local/bin/chezmoi-health"
hn() { [ -x "$HEALTH" ] && "$HEALTH" "$@" >/dev/null 2>&1 || :; }
BEHIND_MARKER="$HOME/.cache/chezmoi-behind"
rm -f "$HOME/.cache/chezmoi-stale"
export GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=20'
CZ=""
for c in "$HOME/.local/bin/chezmoi" /opt/homebrew/bin/chezmoi /usr/local/bin/chezmoi; do
  [ -x "$c" ] && CZ="$c" && break
done
[ -n "$CZ" ] || CZ="$(command -v chezmoi 2>/dev/null || true)"
SRC="$("$CZ" source-path 2>/dev/null)" || {
  rm -f "$BEHIND_MARKER"
  hn run skip "notify-only; source unavailable"
  exit 0
}
if ! git -C "$SRC" fetch -q origin >/dev/null 2>&1; then
  rm -f "$BEHIND_MARKER"
  hn run skip "notify-only; fetch failed"
  echo "chezmoi-autoupdate: notify-only; fetch skipped"
  exit 0
fi
BEHIND="$(git -C "$SRC" rev-list --count HEAD..origin/main 2>/dev/null)" || {
  rm -f "$BEHIND_MARKER"
  hn run skip "notify-only; cannot compare origin/main"
  exit 0
}
DIRTY="$(git -C "$SRC" status --porcelain 2>/dev/null)" || {
  rm -f "$BEHIND_MARKER"
  hn run skip "notify-only; cannot inspect source"
  exit 0
}
if [ -z "$DIRTY" ] && [ "$BEHIND" -gt 0 ]; then
  printf "chezmoi: source is %s commits behind origin/main (auto-update off) — review, then run 'chezmoi update'\n" "$BEHIND" > "$BEHIND_MARKER"
else
  rm -f "$BEHIND_MARKER"
fi
hn run ok "notify-only; $BEHIND behind"
echo "chezmoi-autoupdate: notify-only; $BEHIND behind"
exit 0
{{ end -}}

MARKER="$HOME/.cache/chezmoi-stale"
LAST="$HOME/.cache/chezmoi-autoupdate.last"
mkdir -p "$HOME/.cache"

# Structured history for humans and AI agents (see AGENTS.md "Fleet health").
# Guarded so a box that hasn't applied chezmoi-health yet still auto-updates.
HEALTH="$HOME/.local/bin/chezmoi-health"
hn() { [ -x "$HEALTH" ] && "$HEALTH" "$@" >/dev/null 2>&1 || :; }

# warn "<msg>" [status]  — leave the one-line marker zshrc surfaces, record a
# run event (default status "degraded"), and exit success so the timer does
# not retry-storm.
warn() { printf '%s\n' "$1" > "$MARKER"; hn run "${2:-degraded}" "$1"; exit 0; }

# capped <seconds> <cmd...>  — run with a hard wall-clock cap. timeout(1) is
# absent from the stock macOS PATH, so fall back to a background kill. Returns
# 124 when the cap fires (matching timeout(1)).
capped() {
  _s="$1"; shift
  for _t in timeout gtimeout; do
    command -v "$_t" >/dev/null 2>&1 && { "$_t" "$_s" "$@"; return; }
  done
  "$@" & _p=$!
  ( sleep "$_s"; kill "$_p" 2>/dev/null ) & _k=$!
  wait "$_p" 2>/dev/null; _r=$?
  kill "$_k" 2>/dev/null; wait "$_k" 2>/dev/null
  [ "$_r" -ge 128 ] && _r=124
  return "$_r"
}

CZ=""
for c in "$HOME/.local/bin/chezmoi" /opt/homebrew/bin/chezmoi /usr/local/bin/chezmoi; do
  [ -x "$c" ] && CZ="$c" && break
done
command -v git >/dev/null 2>&1 || exit 0
[ -n "$CZ" ] || CZ="$(command -v chezmoi 2>/dev/null || true)"
[ -n "$CZ" ] || warn "chezmoi: autoupdate cannot find the chezmoi binary — reinstall to ~/.local/bin"

SRC="$("$CZ" source-path 2>/dev/null)" || exit 0
[ -d "$SRC/.git" ] || exit 0

# Converged = chezmoi status runs AND reports nothing pending.
converged() { out="$("$CZ" status --no-tty 2>/dev/null)" || return 1; [ -z "$out" ]; }

# The generated config goes stale when .chezmoi.toml.tmpl changes upstream;
# apply then renders with old data until 'chezmoi init' re-runs.
config_drift() {
  RECORDED="$("$CZ" state dump 2>/dev/null | sed -n 's/.*configTemplateContentsSHA256": "\([0-9a-f]*\)".*/\1/p')"
  ACTUAL="$( (sha256sum "$SRC/.chezmoi.toml.tmpl" 2>/dev/null || shasum -a 256 "$SRC/.chezmoi.toml.tmpl" 2>/dev/null) | cut -d' ' -f1)"
  [ -n "$RECORDED" ] && [ -n "$ACTUAL" ] && [ "$RECORDED" != "$ACTUAL" ]
}

# Never hang on a prompt or a wedged network: batch-mode ssh, no terminal
# prompts, and a hard cap where timeout(1) exists.
export GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=20'
TO=""; command -v timeout >/dev/null 2>&1 && TO="timeout 300"
$TO git -C "$SRC" fetch -q origin || warn "chezmoi: could not fetch origin (offline?) — run 'chezmoi update' manually"

# The fleet follows main only. A clone left on another branch (a migration or
# feature checkout) is someone's work in progress: never auto-apply it.
UPSTREAM=origin/main
BRANCH="$(git -C "$SRC" symbolic-ref -q --short HEAD 2>/dev/null)"
[ "$BRANCH" = main ] \
  || warn "chezmoi: source is on '${BRANCH:-detached HEAD}', not main — auto-update skipped" skip
git -C "$SRC" rev-parse --verify -q "$UPSTREAM^{commit}" >/dev/null \
  || warn "chezmoi: cannot resolve '$UPSTREAM' — reconcile manually"
# Pin the commit: verification, the pre-apply check and the fast-forward must
# all see the same tip.
TIP="$(git -C "$SRC" rev-parse "$UPSTREAM^{commit}")"
BEHIND="$(git -C "$SRC" rev-list --count "HEAD..$TIP" 2>/dev/null)"
[ -n "$BEHIND" ] || warn "chezmoi: cannot compare against $UPSTREAM — reconcile manually"

# The nvim config is a git-repo external: only 'chezmoi apply' pulls it, and
# apply runs only when this repo moves. Pull it on quiet runs too, or nvim-only
# pushes never reach the fleet. Fast-forward only; a failure is noted, not fatal.
# Not signature-verified by decision: the gates below cover shdots only.
refresh_nvim() {
  NV="$HOME/.config/nvim"
  [ -d "$NV/.git" ] || return 0
  if nv_out="$($TO git -C "$NV" pull -q --ff-only 2>&1)"; then
    hn note autoupdate nvim-config ok "$(git -C "$NV" rev-parse --short HEAD 2>/dev/null)"
  else
    hn note autoupdate nvim-config degraded "git pull --ff-only failed: $(printf '%s' "$nv_out" | tail -n 1)"
  fi
}

if [ "$BEHIND" -eq 0 ]; then
  refresh_nvim
  config_drift && warn "chezmoi: config template changed upstream — run 'chezmoi init'"
  if converged; then hn run ok ""; rm -f "$MARKER"
  else warn "chezmoi: source is current but \$HOME is not applied — run 'chezmoi apply'"; fi
  exit 0
fi
if [ -n "$(git -C "$SRC" status --porcelain 2>/dev/null)" ]; then
  warn "chezmoi: source repo has local edits and is $BEHIND commit(s) behind $UPSTREAM — reconcile, then 'chezmoi update'"
fi
if ! git -C "$SRC" merge-base --is-ancestor HEAD "$TIP" 2>/dev/null; then
  warn "chezmoi: source repo has diverged from $UPSTREAM — reconcile, then 'chezmoi update'"
fi
# GPG is a separate allowlist from SSH's managed allowed_signers. GitHub signs
# web-interface commits with its web-flow key, so verify those in an isolated
# keyring containing only the pinned public key. Its current fingerprint is
# 968479A1AFF927E37D1A566BB5690EEEBB952194 (from github.com/web-flow.gpg).
# Recheck that source and fingerprint before rotating the key. Other formats
# still use normal Git verification and the SSH allowed_signers file.
# Every incoming commit is checked, not just the tip: an unsigned commit must
# not ride along behind a signed merge.
GNUPG_HOME=""
cleanup() { [ -n "$GNUPG_HOME" ] && rm -rf "$GNUPG_HOME"; [ -n "${GATE:-}" ] && rm -rf "$GATE"; }
trap cleanup EXIT

verify_commit() {
  if git -C "$SRC" cat-file commit "$1" 2>/dev/null \
    | grep -q '^gpgsig -----BEGIN PGP SIGNATURE-----'; then
    if [ -z "$GNUPG_HOME" ]; then
      GNUPG_HOME="$(mktemp -d "${TMPDIR:-/tmp}/chezmoi-gpg.XXXXXX")" || return 1
      chmod 700 "$GNUPG_HOME" \
        && gpg --homedir "$GNUPG_HOME" --batch --import \
          "$SRC/dot_config/git/github-web-flow.gpg.asc" >/dev/null 2>&1 \
        || return 1
    fi
    GNUPGHOME="$GNUPG_HOME" git -C "$SRC" -c gpg.format=openpgp \
      verify-commit "$1" >/dev/null 2>&1
  else
    git -C "$SRC" verify-commit "$1" >/dev/null 2>&1
  fi
}

for c in $(git -C "$SRC" rev-list "HEAD..$TIP"); do
  verify_commit "$c" \
    || warn "chezmoi: $(git -C "$SRC" rev-parse --short "$c") on $UPSTREAM is not signed by a trusted key — refusing to auto-apply"
done

# Render the verified tip before touching the clone. A template error, or a
# shell file zsh cannot parse, would otherwise land on every auto-updating
# machine (and a template error aborts apply after other files are written).
# Encrypted files are skipped so no plaintext reaches the temp dir; externals
# and run scripts are rendered as text, never pulled or executed.
# gate writes its reason to $GATE/reason and returns non-zero on failure.
gate() {
  mkdir "$GATE/src" "$GATE/out" || return 1
  git -C "$SRC" archive "$TIP" | tar -x -C "$GATE/src" || return 1
  if ! "$CZ" --source "$GATE/src" archive --no-tty --exclude externals,encrypted \
      >"$GATE/out.tar" 2>"$GATE/err"; then
    grep -v 'config file template has changed' "$GATE/err" | tail -n 1 >"$GATE/reason"
    return 1
  fi
  tar -x -C "$GATE/out" -f "$GATE/out.tar" || return 1
  command -v zsh >/dev/null 2>&1 || return 0
  for f in "$GATE/out/.zshenv" "$GATE/out/.zprofile" "$GATE/out/.zshrc" \
      $(find "$GATE/out" -name '*.zsh' -type f); do
    [ -f "$f" ] || continue
    if ! zsh -n "$f" 2>"$GATE/err"; then
      echo "${f#"$GATE/out/"}: $(head -n 1 "$GATE/err")" >"$GATE/reason"
      return 1
    fi
  done
}
GATE="$(mktemp -d "${TMPDIR:-/tmp}/chezmoi-gate.XXXXXX")" \
  || warn "chezmoi: cannot create a temp dir for the pre-apply check" fail
if ! gate; then
  warn "chezmoi: $UPSTREAM fails the pre-apply check ($(cat "$GATE/reason" 2>/dev/null || echo render failed)) — refusing to auto-apply" fail
fi

# Fast-forward to the exact commit that was just verified, then apply — not
# 'chezmoi update', whose own git pull re-fetches and could apply a newer,
# unverified tip (verify/apply race). The apply is capped (below the systemd
# unit's 15-min TimeoutStartSec, so this handler wins) so a hung run-script —
# e.g. a blocked `op read` — wedges one run, not the timer forever.
: > "$LAST"
git -C "$SRC" merge --ff-only "$TIP" >>"$LAST" 2>&1 \
  || warn "chezmoi: fast-forward to $UPSTREAM failed — see $LAST"

capped 720 "$CZ" apply --no-tty >>"$LAST" 2>&1
apply_rc=$?
if [ "$apply_rc" -eq 124 ]; then
  warn "chezmoi: apply timed out after 720s — a run-script is hanging; see $LAST" timeout
elif [ "$apply_rc" -ne 0 ]; then
  warn "chezmoi: apply exited $apply_rc — see $LAST" fail
elif converged; then
  config_drift && warn "chezmoi: config template changed upstream — run 'chezmoi init'"
  hn run ok ""
  rm -f "$MARKER"
else
  warn "chezmoi: apply finished but \$HOME is not fully applied — run 'chezmoi apply'"
fi
