#!/bin/sh
# Keep the fleet converged without touching shell startup: run from launchd
# (mac) / a systemd user timer (vm), auto-apply only when it is provably safe,
# and otherwise leave a marker that zshrc surfaces as a one-line warning.
#
# Safe to auto-apply means: source clone has no local edits AND origin is a
# strict fast-forward ahead. Anything else (divergence, dirty tree, failed
# apply) writes ~/.cache/chezmoi-stale with the reason and leaves the human
# in the loop. Never modifies a diverged clone. The marker is cleared only
# when $HOME provably matches the source (chezmoi status empty), not merely
# when the clone is up to date.
set -u

MARKER="$HOME/.cache/chezmoi-stale"
LAST="$HOME/.cache/chezmoi-autoupdate.last"
mkdir -p "$HOME/.cache"

# Structured history for humans and AI agents (see AGENTS.md "Fleet health").
# Guarded so a box that hasn't applied chezmoi-health yet still auto-updates.
HEALTH="$HOME/.local/bin/chezmoi-health"
hn() { [ -x "$HEALTH" ] && "$HEALTH" "$@" >/dev/null 2>&1 || :; }

# warn "<msg>" [status]  — leave the one-line marker zshrc surfaces, record a
# run event (default status "degraded"), and exit success so the timer does
# not retry-storm.
warn() { printf '%s\n' "$1" > "$MARKER"; hn run "${2:-degraded}" "$1"; exit 0; }

# capped <seconds> <cmd...>  — run with a hard wall-clock cap. timeout(1) is
# absent from the stock macOS PATH, so fall back to a background kill. Returns
# 124 when the cap fires (matching timeout(1)).
capped() {
  _s="$1"; shift
  for _t in timeout gtimeout; do
    command -v "$_t" >/dev/null 2>&1 && { "$_t" "$_s" "$@"; return; }
  done
  "$@" & _p=$!
  ( sleep "$_s"; kill "$_p" 2>/dev/null ) & _k=$!
  wait "$_p" 2>/dev/null; _r=$?
  kill "$_k" 2>/dev/null; wait "$_k" 2>/dev/null
  [ "$_r" -ge 128 ] && _r=124
  return "$_r"
}

CZ=""
for c in "$HOME/.local/bin/chezmoi" /opt/homebrew/bin/chezmoi /usr/local/bin/chezmoi; do
  [ -x "$c" ] && CZ="$c" && break
done
command -v git >/dev/null 2>&1 || exit 0
[ -n "$CZ" ] || CZ="$(command -v chezmoi 2>/dev/null || true)"
[ -n "$CZ" ] || warn "chezmoi: autoupdate cannot find the chezmoi binary — reinstall to ~/.local/bin"

SRC="$("$CZ" source-path 2>/dev/null)" || exit 0
[ -d "$SRC/.git" ] || exit 0

# Converged = chezmoi status runs AND reports nothing pending.
converged() { out="$("$CZ" status --no-tty 2>/dev/null)" || return 1; [ -z "$out" ]; }

# The generated config goes stale when .chezmoi.toml.tmpl changes upstream;
# apply then renders with old data until 'chezmoi init' re-runs.
config_drift() {
  RECORDED="$("$CZ" state dump 2>/dev/null | sed -n 's/.*configTemplateContentsSHA256": "\([0-9a-f]*\)".*/\1/p')"
  ACTUAL="$( (sha256sum "$SRC/.chezmoi.toml.tmpl" 2>/dev/null || shasum -a 256 "$SRC/.chezmoi.toml.tmpl" 2>/dev/null) | cut -d' ' -f1)"
  [ -n "$RECORDED" ] && [ -n "$ACTUAL" ] && [ "$RECORDED" != "$ACTUAL" ]
}

# Never hang on a prompt or a wedged network: batch-mode ssh, no terminal
# prompts, and a hard cap where timeout(1) exists.
export GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND='ssh -o BatchMode=yes -o ConnectTimeout=20'
TO=""; command -v timeout >/dev/null 2>&1 && TO="timeout 300"
$TO git -C "$SRC" fetch -q origin || warn "chezmoi: could not fetch origin (offline?) — run 'chezmoi update' manually"

UPSTREAM="$(git -C "$SRC" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || echo origin/main)"
git -C "$SRC" rev-parse --verify -q "$UPSTREAM^{commit}" >/dev/null \
  || warn "chezmoi: cannot resolve upstream '$UPSTREAM' — reconcile manually"
BEHIND="$(git -C "$SRC" rev-list --count "HEAD..$UPSTREAM" 2>/dev/null)"
[ -n "$BEHIND" ] || warn "chezmoi: cannot compare against $UPSTREAM — reconcile manually"

if [ "$BEHIND" -eq 0 ]; then
  config_drift && warn "chezmoi: config template changed upstream — run 'chezmoi init'"
  if converged; then hn run ok ""; rm -f "$MARKER"
  else warn "chezmoi: source is current but \$HOME is not applied — run 'chezmoi apply'"; fi
  exit 0
fi
if [ -n "$(git -C "$SRC" status --porcelain 2>/dev/null)" ]; then
  warn "chezmoi: source repo has local edits and is $BEHIND commit(s) behind $UPSTREAM — reconcile, then 'chezmoi update'"
fi
if ! git -C "$SRC" merge-base --is-ancestor HEAD "$UPSTREAM" 2>/dev/null; then
  warn "chezmoi: source repo has diverged from $UPSTREAM — reconcile, then 'chezmoi update'"
fi
# Supply-chain gate: only auto-apply commits signed by a key in the managed
# allowed_signers. Merge commits are disabled repo-side, so the tip is always
# an SSH-signed commit; anything unverifiable waits for a human.
if ! git -C "$SRC" verify-commit "$UPSTREAM" >/dev/null 2>&1; then
  warn "chezmoi: $UPSTREAM is not signed by a trusted key — refusing to auto-apply"
fi

# Fast-forward to the exact commit that was just verified, then apply — not
# 'chezmoi update', whose own git pull re-fetches and could apply a newer,
# unverified tip (verify/apply race). The apply is capped (below the systemd
# unit's 15-min TimeoutStartSec, so this handler wins) so a hung run-script —
# e.g. a blocked `op read` — wedges one run, not the timer forever.
: > "$LAST"
git -C "$SRC" merge --ff-only "$UPSTREAM" >>"$LAST" 2>&1 \
  || warn "chezmoi: fast-forward to $UPSTREAM failed — see $LAST"

capped 720 "$CZ" apply --no-tty >>"$LAST" 2>&1
apply_rc=$?
if [ "$apply_rc" -eq 124 ]; then
  warn "chezmoi: apply timed out after 720s — a run-script is hanging; see $LAST" timeout
elif [ "$apply_rc" -ne 0 ]; then
  warn "chezmoi: apply exited $apply_rc — see $LAST" fail
elif converged; then
  config_drift && warn "chezmoi: config template changed upstream — run 'chezmoi init'"
  hn run ok ""
  rm -f "$MARKER"
else
  warn "chezmoi: apply finished but \$HOME is not fully applied — run 'chezmoi apply'"
fi
