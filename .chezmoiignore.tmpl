# Repository-only assets (never applied to $HOME). AGENTS.md / CLAUDE.md are
# this repo's own agent instructions; the global AI baseline renders into each
# tool's native global file instead (see AGENTS.md "AI tooling layout").
AGENTS.md
CLAUDE.md
docs
provision
README.md
tests
**/__pycache__

# Secrets and host-generated SSH state are deliberately unmanaged.
.npmrc
.ssh/id_*
.ssh/known_hosts*

# herdr runtime state is not reproducible configuration. Plugins and integrations
# are reproduced by run_onchange_after_45-herdr-plugins.sh, never checked in:
# .config/herdr/plugins/github holds git clones + built binaries (incl. .git),
# plugins.json/.plugins.lock/release-notes.json are generated, config.toml.hwf.*
# is the herdr-workflows setup backup. Under plugins/config/<id> we track only
# hand-written user config (usagebar/config.toml, persiyanov.reviewr/config.toml);
# everything else there is per-run state or machine-generated layers.
.config/herdr/.plugins.lock
.config/herdr/*.log
.config/herdr/session.json
.config/herdr/*.sock
.config/herdr/plugins.json
.config/herdr/release-notes.json
.config/herdr/config.toml.hwf.*
.config/herdr/plugins/github
.config/herdr/plugins/config/*/update-check-state.json
.config/herdr/plugins/config/*/*.log
# herdr-lazygit writes these from keys.conf / pane state; only a user-authored
# lazygit-user.yml or keys.conf under this dir would be worth tracking.
.config/herdr/plugins/config/herdr-lazygit/generated.yml
.config/herdr/plugins/config/herdr-lazygit/layout-*.yml
.local/state/herdr
# herdr-automatic-rename's opt-out records and mkdir lock. Fixed path, not
# $HERDR_PLUGIN_STATE_DIR, because its zsh hooks run outside herdr and must
# name the same store; created on the plugin's first reconcile. Generated.
.local/state/herdr-automatic-rename
# Saved SSH machines (herdr 0.9+, `herdr machine`) are local control-plane state,
# not portable config. Exact store path
# is unmaterialised until the first `herdr machine add`; confirm on as-host before
# relying on this glob.
.config/herdr/machines
.config/herdr/machines.*

