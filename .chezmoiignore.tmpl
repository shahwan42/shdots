# Repository-only assets (never applied to $HOME).
provision
AGENTS.md
README.md

# Secrets and host-generated SSH state are deliberately unmanaged.
.npmrc
.ssh/id_*
.ssh/known_hosts*

# herdr runtime state is not reproducible configuration.
.config/herdr/.plugins.lock
.config/herdr/*.log
.config/herdr/session.json
.config/herdr/*.sock

{{ if ne .kind "mac" -}}
# macOS-only configuration.
Brewfile
.config/aerospace
Library
{{ end -}}

{{ if ne .role "work" -}}
# Work SSH hosts are age-encrypted and only decryptable/relevant on work machines.
# Non-work machines have no encryption configured, so chezmoi can't strip the .age
# suffix and computes the target as `foodics.age` — ignore both names.
.ssh/config.d/foodics
.ssh/config.d/foodics.age
{{ end -}}
