{{ if ne .kind "vm" -}}
# systemd user units are VM-only; macs schedule via launchd.
.config/systemd
# The mmdc wrapper works around Linux/arm64 browser gaps; Macs use the mise shim.
.local/bin/mmdc
{{ end -}}

{{ if not (and (eq .hostname "as-host") (includeTemplate "has-personal" .)) -}}
# authorized_keys is built for as-host only. Everywhere else the file is
# host-generated (multipass injects its key) and must not be managed.
.ssh/authorized_keys
{{ end -}}

{{ if not (and (eq .kind "mac") (includeTemplate "has-personal" .)) -}}
# Hetzner keeper SSH host: personal Macs only (the keeper trusts workstation keys).
.ssh/config.d/personal/shahwan
{{ end -}}

{{ if not (includeTemplate "has-work" .) -}}
# Legacy encrypted Work SSH hosts are relevant only to work compatibility VMs.
# (chezmoiignore matches TARGET paths — the encrypted_/.age source decorations
# are already stripped, so a foodics.age entry would never match.)
.ssh/config.d/foodics
{{ end -}}

{{ if not (and (includeTemplate "has-work" .) (dig "eod" false .)) -}}
# The eod skill belongs to work accounts and is opt-in (the `eod`
# prompt in .chezmoi.toml.tmpl); new accounts default to absent.
.claude/skills/eod
{{ end -}}

{{ if not (stat (joinPath .chezmoi.homeDir ".agents/skills/browser-harness/SKILL.md")) -}}
# The Claude browser-harness adapter links to the skill the browser-harness
# install writes to ~/.agents/skills. Where that install has not written it
# (VMs, older browser-harness releases), the link would dangle.
.claude/skills/browser-harness
{{ end -}}

{{ if includeTemplate "has-personal" . -}}
# Where Caveman is installed (script 44), Claude already has these four as
# caveman:* plugin skills; an adapter would list each twice. Elsewhere (work
# VMs) the adapter is Claude's only copy.
.claude/skills/investigate-first
.claude/skills/safe-refactor
.claude/skills/verify-and-stop
.claude/skills/migration
{{ end -}}

# Old directory-based Git identity overrides are obsolete on dedicated accounts.
.config/git/work.gitconfig
