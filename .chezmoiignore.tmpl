# Repository-only assets (never applied to $HOME).
provision
README.md

# Secrets and host-generated SSH state are deliberately unmanaged.
.npmrc
.ssh/id_*
.ssh/known_hosts*

# herdr runtime state is not reproducible configuration. Plugins and integrations
# are reproduced by run_onchange_after_45-herdr-plugins.sh, never checked in:
# .config/herdr/plugins/github holds git clones + built binaries (incl. .git),
# plugins.json/.plugins.lock/release-notes.json are generated, config.toml.hwf.*
# is the herdr-workflows setup backup, and plugins/config/*/update-check-state.json
# is per-run state beside the plugin config we *do* track.
.config/herdr/.plugins.lock
.config/herdr/*.log
.config/herdr/session.json
.config/herdr/*.sock
.config/herdr/plugins.json
.config/herdr/release-notes.json
.config/herdr/config.toml.hwf.*
.config/herdr/plugins/github
.config/herdr/plugins/config/*/update-check-state.json
.config/herdr/plugins/config/*/*.log
.local/state/herdr

{{ if ne .kind "mac" -}}
# macOS-only configuration.
Brewfile
.config/ghostty
.config/kitty
.config/flameshot
Library
{{ end -}}

{{ if ne .kind "vm" -}}
# systemd user units are VM-only; macs schedule via launchd.
.config/systemd
# The mmdc wrapper works around Linux/arm64 browser gaps; Macs use the mise shim.
.local/bin/mmdc
{{ end -}}

{{ if ne .hostname "as-host" -}}
# authorized_keys is built for as-host only. Everywhere else the file is
# host-generated (multipass injects its key) and must not be managed.
.ssh/authorized_keys
{{ end -}}

{{ if ne .role "personal" -}}
# Personal SSH hosts (Hetzner) are only relevant on personal machines.
.ssh/config.d/shahwan
{{ end -}}

{{ if ne .role "work" -}}
# Work SSH hosts are only relevant on work machines.
# (chezmoiignore matches TARGET paths — the encrypted_/.age source decorations
# are already stripped, so a foodics.age entry would never match.)
.ssh/config.d/foodics
# flameshot is installed by the work Brewfile only.
.config/flameshot
{{ end -}}
