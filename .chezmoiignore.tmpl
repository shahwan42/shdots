# Repository-only assets (never applied to $HOME).
provision
AGENTS.md
README.md

# Secrets and host-generated SSH state are deliberately unmanaged.
.npmrc
.ssh/id_*
.ssh/known_hosts*

# herdr runtime state is not reproducible configuration.
.config/herdr/.plugins.lock
.config/herdr/*.log
.config/herdr/session.json
.config/herdr/*.sock

{{ if ne .kind "mac" -}}
# macOS-only configuration.
Brewfile
.config/aerospace
.config/ghostty
.config/flameshot
Library
{{ end -}}

{{ if ne .kind "vm" -}}
# systemd user units are VM-only; macs schedule via launchd.
.config/systemd
# The mmdc wrapper works around Linux/arm64 browser gaps; Macs use the mise shim.
.local/bin/mmdc
{{ end -}}

{{ if ne .role "work" -}}
# Work SSH hosts are only relevant on work machines.
# (chezmoiignore matches TARGET paths — the encrypted_/.age source decorations
# are already stripped, so a foodics.age entry would never match.)
.ssh/config.d/foodics
# flameshot is installed by the work Brewfile only.
.config/flameshot
{{ end -}}
