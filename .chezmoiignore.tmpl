# Repository-only provisioning assets.
provision

# Secrets and host-generated SSH state are deliberately unmanaged.
.npmrc
.ssh/id_*
.ssh/known_hosts*

# herdr runtime state is not reproducible configuration.
.config/herdr/.plugins.lock
.config/herdr/*.log
.config/herdr/session.json
.config/herdr/*.sock

{{ if ne .kind "mac" -}}
# macOS-only configuration.
Brewfile
.config/aerospace
Library
{{ end -}}

{{ if eq .kind "vm" -}}
# mise global tool selection is machine-specific on VMs (node/php/eza installed
# via mise here vs. Homebrew on Macs); let `mise use` manage it, not chezmoi.
.config/mise/config.toml
{{ end -}}
