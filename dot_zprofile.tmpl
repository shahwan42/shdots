# Login-shell environment managed by chezmoi.

# Homebrew (macOS or Linuxbrew) — probe known prefixes; no-op if absent.
for _brew in /opt/homebrew/bin/brew /usr/local/bin/brew /home/linuxbrew/.linuxbrew/bin/brew; do
  [[ -x "$_brew" ]] && eval "$("$_brew" shellenv)" && break
done
unset _brew

export EDITOR=nvim
export VISUAL=nvim

if [[ -d "$HOME/.local/bin" ]]; then
  path=("$HOME/.local/bin" $path)
fi
if [[ -d "$HOME/.composer/vendor/bin" ]]; then
  path=("$HOME/.composer/vendor/bin" $path)
fi
# Remove the path inherited from the retired SnowflakeCLI.app installer.
path=(${path:#/Applications/SnowflakeCLI.app/Contents/MacOS/})
typeset -U path PATH

if [[ -d /Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home ]]; then
  export JAVA_HOME=/Library/Java/JavaVirtualMachines/zulu-17.jdk/Contents/Home
fi
