# vim: filetype=sshconfig

# Skip options a platform doesn't know (e.g. UseKeychain is macOS-only) instead
# of aborting the whole parse. Global, set before any Include.
Host *
	IgnoreUnknown UseKeychain

# Include configurations from other files (work SSH hosts arrive here, decrypted).
Include ~/.ssh/config.d/*
# -- Orbstack config
# Include ~/.orbstack/ssh/config


# Multipass dev VMs (tailnet names) — default user so `ssh fdx-dev` just works.
Host fdx-dev as-dev
	User ubuntu

# The Macs that host them. The tailnet machines are named fdx-host / as-host in
# the admin console — keep those names authoritative; MagicDNS resolves them.
# `User as` matters from inside a VM, where the local user is `ubuntu`.
Host fdx-host as-host
	User as
	# Offer this machine's own key explicitly: the VM keys use non-default names
	# that ssh would otherwise never try, so scp/rsync to the Mac would fail.
	IdentityFile ~/.ssh/{{ template "ssh-self-key" . }}

# Keep SSH connections alive by sending keepalive messages every 60 seconds.
# Try 3 times.
Host *
	ServerAliveInterval 60
	ServerAliveCountMax 3


