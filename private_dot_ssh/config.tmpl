# vim: filetype=sshconfig
Host *
    IgnoreUnknown UseKeychain

# Account-local host declarations; legacy mixed config.d files are not loaded.
{{ if includeTemplate "has-work" . -}}
Include ~/.ssh/config.d/work/*
{{ else -}}
Include ~/.ssh/config.d/personal/*
{{ end }}
# Optional compatibility VM on this machine; never opens a remote session.
Host linux-compat
    HostName fdx-dev.local
    User ubuntu

{{ if includeTemplate "has-personal" . -}}
# Administrative access remains in the personal account.
Host fdx-host as-host
    User as
    IdentityFile ~/.ssh/id_ed25519

Host github.com
    IdentityAgent none
    IdentityFile ~/.ssh/id_ed25519
    IdentitiesOnly yes
{{ else -}}
# Provision a fresh account-local Git key later. Public GitHub is optional;
# it uses this work account's key and login, never the personal account's.
Host github.foodics.com github.com
    IdentityAgent none
    IdentityFile ~/.ssh/{{ template "git-signing-key" . }}
    IdentitiesOnly yes
{{ end }}
Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3
