{{ if eq .kind "mac" -}}
# GitHub via on-disk key. The 1Password SSH agent is retired: it's gated by the
# desktop app's GUI unlock, which breaks headless/SSH sessions.
# Per-machine keys on purpose — identifies which machine is connecting.
# Which key is THIS machine's identity lives in .chezmoitemplates/ssh-self-key.
Host github.com github.foodics.com
	IdentityAgent none
	IdentityFile ~/.ssh/{{ template "ssh-self-key" . }}
	IdentitiesOnly yes
{{ else if eq .role "work" -}}
# Work VM: split identities — the work key never touches personal repos.
Host github.foodics.com
	IdentityAgent none
	IdentityFile ~/.ssh/id_ed25519_foodics
	IdentitiesOnly yes
Host github.com
	IdentityAgent none
	IdentityFile ~/.ssh/id_ed25519_personal
	IdentitiesOnly yes
{{ else -}}
Host github.com
	IdentityAgent none
	IdentityFile ~/.ssh/id_ed25519_personal
	IdentitiesOnly yes
{{ end -}}
