# vim: filetype=sshconfig
# Settings shared by every account. Hosts live in config.d/personal and
# config.d/work; config.d/work/foodics holds company servers and is local-only.
Host *
    IgnoreUnknown UseKeychain

{{ if includeTemplate "has-personal" . -}}
Include ~/.ssh/config.d/personal/*
{{ end -}}
{{ if includeTemplate "has-work" . -}}
Include ~/.ssh/config.d/work/*
{{ end }}
# Optional compatibility VM on this machine; never opens a remote session.
Host linux-compat
    HostName fdx-dev.local
    User ubuntu

Host *
    ServerAliveInterval 60
    ServerAliveCountMax 3
