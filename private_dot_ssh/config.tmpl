# vim: filetype=sshconfig

# Skip options a platform doesn't know (e.g. UseKeychain is macOS-only) instead
# of aborting the whole parse. Global, set before any Include.
Host *
	IgnoreUnknown UseKeychain

# Include configurations from other files (work SSH hosts arrive here, decrypted).
Include ~/.ssh/config.d/*
# -- Orbstack config
# Include ~/.orbstack/ssh/config


# Multipass dev VMs (tailnet names) — default user so `ssh fdx-dev` just works.
Host fdx-dev
	User ubuntu

# Keep SSH connections alive by sending keepalive messages every 60 seconds.
# Try 3 times.
Host *
	ServerAliveInterval 60
	ServerAliveCountMax 3


