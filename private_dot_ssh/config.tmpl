# vim: filetype=sshconfig

# Skip options a platform doesn't know (UseKeychain is macOS-only) instead of
# aborting the parse. Must stay above the Include.
Host *
	IgnoreUnknown UseKeychain

# Work and personal SSH hosts land here, decrypted.
Include ~/.ssh/config.d/*

# Multipass dev VMs, by tailnet name.
Host fdx-dev as-dev
	User ubuntu

# The Macs hosting them. These tailnet names are authoritative (they match the
# admin console); MagicDNS resolves them. User matters from inside a VM, where
# the local user is ubuntu. Tailscale SSH is the primary path between fleet
# machines; the key below is the fallback when tailscaled is down or the hop is
# LAN-local. Which key is this machine's identity: .chezmoitemplates/ssh-self-key.
Host fdx-host as-host
	User as
	IdentityFile ~/.ssh/{{ template "ssh-self-key" . }}

# Keepalives for every host: ping every 60s, give up after 3. Separate block
# because only the IgnoreUnknown one above needs to precede the Include.
Host *
	ServerAliveInterval 60
	ServerAliveCountMax 3

{{ if eq .kind "mac" -}}
# On-disk key, not the 1Password agent: that one needs the desktop app's GUI
# unlock, which breaks headless sessions. Keys are per-machine on purpose, so
# the key identifies the machine connecting — see .chezmoitemplates/ssh-self-key.
Host github.com github.foodics.com
	IdentityAgent none
	IdentityFile ~/.ssh/{{ template "ssh-self-key" . }}
	IdentitiesOnly yes
{{ else if eq .role "work" -}}
# Work VM: split identities — the work key never touches personal repos.
Host github.foodics.com
	IdentityAgent none
	IdentityFile ~/.ssh/id_ed25519_foodics
	IdentitiesOnly yes
Host github.com
	IdentityAgent none
	IdentityFile ~/.ssh/{{ template "ssh-self-key" . }}
	IdentitiesOnly yes
{{ else -}}
Host github.com
	IdentityAgent none
	IdentityFile ~/.ssh/{{ template "ssh-self-key" . }}
	IdentitiesOnly yes
{{ end -}}
