{{ if eq .kind "mac" -}}
# GitHub via on-disk key. The 1Password SSH agent is retired: it's gated by the
# desktop app's GUI unlock, which breaks headless/SSH sessions.
Host github.com github.foodics.com
	IdentityAgent none
	IdentityFile ~/.ssh/id_ed25519
	IdentitiesOnly yes
{{ end -}}
