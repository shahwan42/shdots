# Homebrew now holds ONLY what mise/chezmoi shouldn't: behavior-sensitive native
# libraries, system services, and GUI apps. The cross-platform CLI toolchain
# lives in ~/.config/mise/config.toml (shared). chezmoi and mise are installed
# via their curl bootstrappers (see README), not here.

# --- behavior-sensitive natives (shared across Macs) ---
brew "coreutils"        # GNU coreutils; mise only offers the Rust uutils rewrite
brew "MisterTea/et/et"  # Eternal Terminal: reconnect-surviving remote shell (client+server)
brew "ffmpeg"           # heavy codec/delegate chain — leave to the OS pkg mgr
brew "git"
brew "gnupg"
brew "lsof"
brew "pinentry-mac"
brew "qemu"
brew "sevenzip"
brew "tree"
brew "wget"

# --- GUI apps / casks (shared across Macs) ---
cask "1password"       # desktop app: SSH agent for the work-server key
cask "1password-cli"
cask "alt-tab"
cask "codex"
cask "font-meslo-lg-nerd-font"
cask "ghostty"
cask "google-chrome"  # browser-harness drives Chrome over CDP
cask "kitty"
cask "multipass"
cask "rectangle"
brew "tailscale"        # CLI/daemon formula — both Macs run tailscaled from it; the GUI app is not used
cask "visual-studio-code"
cask "vlc"
cask "zulu@17"
