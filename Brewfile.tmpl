# Homebrew now holds ONLY what mise/chezmoi shouldn't: behavior-sensitive native
# libraries, system services, and GUI apps. The cross-platform CLI toolchain
# lives in ~/.config/mise/config.toml (shared). chezmoi and mise are installed
# via their curl bootstrappers (see README), not here.

# --- behavior-sensitive natives (shared across Macs) ---
brew "coreutils"        # GNU coreutils; mise only offers the Rust uutils rewrite
brew "ffmpeg"           # heavy codec/delegate chain — leave to the OS pkg mgr
brew "git"
brew "gnupg"
brew "lsof"
brew "pinentry-mac"
brew "qemu"
brew "sevenzip"
brew "tree"
brew "wget"

# --- GUI apps / casks (shared across Macs) ---
cask "1password-cli"
cask "alt-tab"
cask "codex"
cask "font-meslo-lg-nerd-font"
cask "ghostty"
cask "multipass"
cask "rectangle"
cask "tailscale-app"
cask "vlc"
cask "zulu@17"

{{- if eq .role "work" }}

# --- work Mac: native services, PHP/iOS stack, heavy libs, GUI apps ---
brew "autossh"
brew "chafa"
brew "cliclick"
brew "cocoapods"
brew "container-compose"
brew "dnsmasq"
brew "docker"
brew "docker-compose"
brew "ffmpeg-full"
brew "gromgit/brewtils/taproom", trusted: true
brew "imagemagick-full", link: true
brew "leaf-markdown-viewer"
brew "mermaid-cli"     # kept native: mise's npm trust policy flags its dep tree
brew "mole"
brew "nginx"
brew "pcre2"
brew "php", link: false
brew "php@8.3", link: true
brew "poppler"
brew "ruby"
brew "watchman"

cask "1password"
cask "appcleaner"
cask "flameshot"
cask "font-caskaydia-cove-nerd-font"
cask "font-comic-shanns-mono-nerd-font"
cask "font-fira-code-nerd-font"
cask "font-hack-nerd-font"
cask "font-symbols-only-nerd-font"
cask "google-chrome"
cask "kap"
cask "keka"
cask "localsend"
cask "maccy"
cask "ngrok"
cask "time-out"
cask "visual-studio-code"
cask "zoom"
{{ end }}
