#!/bin/sh
# Reconciles this machine's Herdr plugins and agent integrations against the
# per-host desired state in .chezmoidata/herdr.yaml. Additive: it installs what
# is missing or drifted and never uninstalls a plugin you dropped from the list.
#
# Idempotent by construction:
#   - plugin absent               -> herdr plugin install <source> --ref <ref>
#   - plugin at the pinned rev    -> no-op
#   - plugin at a different rev   -> report the drift, then re-pin in place with
#                                   `herdr plugin install --ref` (its output says
#                                   "replaces: <id> ...@<old commit>")
# so a re-run with nothing to do makes no changes and reinstalls nothing.
#
# herdr desired-state hash: {{ include ".chezmoidata/herdr.yaml" | sha256sum }}
#
# Runs after 20-mise-install. On as-dev (kind=vm) the plugin build hooks find
# prebuilt release binaries first and the vm-only Rust/Go toolchains only as a
# fallback. A client host (as-host) carries no plugins, so it needs no build
# toolchain; if a plugin is ever added to a client host, add only that plugin's
# specific dependency to that host — do not make toolchains fleet-wide.
#
# Non-fatal on purpose, like the MCP-sync scripts: a missing tool or a network
# failure must not fail `chezmoi apply`.
set -u

# Structured history (see AGENTS.md "Fleet health"); no-op until applied.
HN="$HOME/.local/bin/chezmoi-health"
hn() { [ -x "$HN" ] && "$HN" note 45-herdr-plugins "$@" >/dev/null 2>&1 || :; }

HERDR="$(command -v herdr || echo "$HOME/.local/share/mise/shims/herdr")"
if ! command -v "$HERDR" >/dev/null 2>&1 && [ ! -x "$HERDR" ]; then
  echo "herdr not found on PATH — skipping plugin/integration sync." >&2
  exit 0
fi

{{ $h := index .herdr.hosts .chezmoi.hostname -}}
{{ if not $h -}}
echo "no Herdr desired-state for {{ .chezmoi.hostname }} in .chezmoidata/herdr.yaml — nothing to do."
exit 0
{{ else if not $h.enabled -}}
echo "Herdr desired-state for {{ .chezmoi.hostname }} is disabled (enabled: false) — nothing to do."
exit 0
{{ end -}}

# Desired plugins: one "source|ref|rev" record per line.
PLUGINS=$(cat <<'EOF'
{{ range $h.plugins }}{{ .source }}|{{ .ref }}|{{ .rev }}
{{ end }}EOF
)
INTEGRATIONS="{{ range $h.integrations }}{{ . }} {{ end }}"

# --- plugins ---------------------------------------------------------------
# Drift detection reads `herdr plugin list --json`; without jq we cannot do it
# safely, so skip rather than risk reinstalling every apply.
if [ -n "$PLUGINS" ] && ! command -v jq >/dev/null 2>&1; then
  echo "jq not found — skipping Herdr plugin sync (cannot read installed set safely)." >&2
  hn plugins skip "jq unavailable"
  PLUGINS=""
fi

plugin_list_json=""
[ -n "$PLUGINS" ] && plugin_list_json="$("$HERDR" plugin list --json 2>/dev/null)"

# Print the resolved_commit for a given owner/repo, or empty if not installed.
installed_rev() {
  printf '%s' "$plugin_list_json" | jq -r --arg s "$1" '
    .result.plugins[]? | select(.source.kind == "github")
    | select((.source.owner + "/" + .source.repo) == $s)
    | .source.resolved_commit // ""' | head -n1
}

printf '%s\n' "$PLUGINS" | while IFS='|' read -r src ref rev; do
  [ -n "$src" ] || continue
  cur="$(installed_rev "$src")"
  short_rev=$(printf '%s' "$rev" | cut -c1-12)

  if [ "$cur" = "$rev" ]; then
    echo "plugin: $src ok ($short_rev)"
    continue
  fi

  if [ -z "$cur" ]; then
    verb="install"
  else
    verb="reconcile"
    echo "plugin: $src DRIFT — installed $(printf '%s' "$cur" | cut -c1-12), pinned $ref ($short_rev)" >&2
    hn "$src" drift "installed $cur, pinned $ref"
  fi

  # `herdr plugin install --ref` re-pins in place; no uninstall needed.
  if "$HERDR" plugin install "$src" --ref "$ref" --yes >/dev/null 2>&1; then
    echo "plugin: $verb $src -> $ref ($short_rev)"
  else
    echo "plugin: $src $verb failed — run 'herdr plugin install $src --ref $ref --yes'." >&2
    hn "$src" fail "herdr plugin $verb failed"
  fi
done

# --- integrations --------------------------------------------------------------
# `herdr integration status` prints "<name>: current (vN) (path)" when installed
# and up to date; anything else (outdated / not installed) means reinstall.
for name in $INTEGRATIONS; do
  if "$HERDR" integration status 2>/dev/null | grep -qE "^${name}: current"; then
    echo "integration: $name current"
    continue
  fi
  if "$HERDR" integration install "$name" >/dev/null 2>&1; then
    echo "integration: $name installed"
  else
    echo "integration: $name install failed — run 'herdr integration install $name'." >&2
    hn "$name" fail "herdr integration install failed"
  fi
done

# Pick up config/keybinding changes in a running server (no-op if none running).
"$HERDR" server reload-config >/dev/null 2>&1 || :

exit 0
