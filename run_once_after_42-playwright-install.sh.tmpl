#!/bin/sh
# Ensure @playwright/mcp's chromium is installed so an agent's first browser
# launch doesn't stall on a download. Best-effort by design: @playwright/mcp
# auto-downloads its own browser on first launch, so a failure here is non-fatal.
# Probe-and-repair shaped like the mermaid-cli blocks in run_onchange_after_20.
#
# The chromium must match the `playwright` version that @playwright/mcp bundles,
# so we read that exact version from the npm registry and install it. If
# resolution or the install fails, the MCP's own auto-download is the fallback.
set -u

# Structured history (see AGENTS.md "Fleet health"); no-op until applied.
HN="$HOME/.local/bin/chezmoi-health"
hn() { [ -x "$HN" ] && "$HN" note 42-playwright-install "$@" >/dev/null 2>&1 || :; }

NODE="$HOME/.local/share/mise/shims/node"
if [ ! -x "$NODE" ]; then
  echo "node not found — skipping Playwright install." >&2
  hn node skip "node unavailable"
  exit 0
fi

NPM="$HOME/.local/share/mise/shims/npm"
[ -x "$NPM" ] || NPM="$(command -v npm || true)"
NPX="$HOME/.local/share/mise/shims/npx"
[ -x "$NPX" ] || NPX="$(command -v npx || true)"
if [ -z "$NPM" ] || [ -z "$NPX" ]; then
  echo "npm/npx not found — skipping Playwright install." >&2
  hn npm skip "npm or npx unavailable"
  exit 0
fi

# Dev origin must be up for the probe (the browser is used against it); skip
# silently otherwise so an unattended auto-update never triggers a big download.
curl -fsS -o /dev/null --max-time 5 "http://localhost:8080" 2>/dev/null || exit 0

# Resolve the exact `playwright` version @playwright/mcp bundles.
ver="$("$NPM" view @playwright/mcp@latest dependencies.playwright 2>/dev/null || true)"
ver="${ver:-latest}"
echo "playwright-mcp bundles playwright@${ver}; installing chromium…"
"$NPX" -y "playwright@$ver" install chromium \
  || { echo "playwright chromium install failed; first MCP launch will auto-download." >&2; hn chromium fail "install failed"; }
exit 0
