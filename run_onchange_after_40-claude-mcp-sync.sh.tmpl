#!/bin/sh
# Reconciles Claude Code's user-scope MCP servers to the declarations below.
# Re-runs whenever this rendered script changes (chezmoi's run_onchange_
# semantics — no manual hash needed since the script IS the declaration).
#
# `claude mcp add` errors on a name that already exists, so each server is
# removed then re-added — that's what makes this idempotent.
set -u

# Structured history (see AGENTS.md "Fleet health"); no-op until applied.
HN="$HOME/.local/bin/chezmoi-health"
hn() { [ -x "$HN" ] && "$HN" note 40-claude-mcp-sync "$@" >/dev/null 2>&1 || :; }

CLAUDE="$(command -v claude || echo "$HOME/.local/share/mise/shims/claude")"
if ! command -v "$CLAUDE" >/dev/null 2>&1 && [ ! -x "$CLAUDE" ]; then
  echo "claude not found on PATH — skipping MCP server sync." >&2
  exit 0
fi

add() {
  name="$1"; shift
  "$CLAUDE" mcp remove "$name" --scope user >/dev/null 2>&1
  if "$CLAUDE" mcp add "$name" --scope user "$@" >/dev/null 2>&1; then
    echo "mcp: $name registered"
  else
    echo "mcp: $name registration failed" >&2
    hn "$name" fail "claude mcp add failed"
  fi
}

# `op read` blocks indefinitely when 1Password has no non-interactive auth
# (no OP_SERVICE_ACCOUNT_TOKEN and no reachable desktop app) — that once hung
# `chezmoi apply` for good. Cap it; an empty result is already non-fatal below.
# timeout(1) isn't on every box (absent from the stock macOS PATH), so fall
# back to a background kill.
op_read() {
  _q="$1"
  for _t in timeout gtimeout; do
    if command -v "$_t" >/dev/null 2>&1; then
      "$_t" 15 op read "$_q" 2>/dev/null
      return
    fi
  done
  op read "$_q" 2>/dev/null &
  _op=$!
  ( sleep 15; kill "$_op" 2>/dev/null ) &
  _kill=$!
  wait "$_op" 2>/dev/null; _rc=$?
  kill "$_kill" 2>/dev/null; wait "$_kill" 2>/dev/null
  return "$_rc"
}

# --- shared everywhere (mac + vm, personal + work) ---
add context7 -- npx -y @upstash/context7-mcp
add shadcn-ui -- npx -y @jpisnice/shadcn-ui-mcp-server
add citra -- npx -y @sylphx/citra

# codebase-memory-mcp ships no package-manager release; its documented
# one-liner installs the binary AND self-registers it. Only (re)install the
# binary if missing — `add` below then makes registration idempotent
# regardless of what the installer already wrote.
# https://github.com/DeusData/codebase-memory-mcp
CBM_BIN="$HOME/.local/bin/codebase-memory-mcp"
if [ ! -x "$CBM_BIN" ]; then
  echo "codebase-memory-mcp: installing…"
  # Upstream install.sh uses `set -o pipefail` (a bashism); Ubuntu's /bin/sh is
  # dash and aborts on it. Pipe to bash, not sh.
  if command -v bash >/dev/null 2>&1; then
    curl -fsSL https://raw.githubusercontent.com/DeusData/codebase-memory-mcp/main/install.sh | bash \
      || { echo "codebase-memory-mcp: install failed; see https://github.com/DeusData/codebase-memory-mcp" >&2
           hn codebase-memory-mcp fail "install.sh exited non-zero"; }
  else
    echo "codebase-memory-mcp: bash not found — cannot run installer; skipping" >&2
    hn codebase-memory-mcp skip "bash not available"
  fi
fi
[ -x "$CBM_BIN" ] && add codebase-memory-mcp -- "$CBM_BIN"

# github-mcp-server: binary comes from mise (dot_config/mise/config.toml.tmpl).
# PAT lives in 1Password; a missing item is non-fatal (same pattern as the
# missing-GITHUB_TOKEN case in run_onchange_after_20-mise-install.sh.tmpl) —
# it must not fail `chezmoi apply`, just skip registration with instructions.
{{ if eq .role "personal" -}}
GH_PAT="$(op_read 'op://Private/GitHub PAT (personal)/credential')"
if [ -n "$GH_PAT" ]; then
  add github -e GITHUB_PERSONAL_ACCESS_TOKEN="$GH_PAT" -- github-mcp-server stdio
else
  echo "github mcp: create 1Password item 'GitHub PAT (personal)' (field: credential) holding a github.com PAT, then re-run 'chezmoi apply'." >&2
  hn github skip "1Password PAT unavailable (op read empty/timed out)"
fi
{{ end -}}
{{ if eq .role "work" -}}
GHE_PAT="$(op_read 'op://Private/GitHub PAT (foodics)/credential')"
if [ -n "$GHE_PAT" ]; then
  add github-enterprise -e GITHUB_PERSONAL_ACCESS_TOKEN="$GHE_PAT" -e GITHUB_HOST="https://github.foodics.com" -- github-mcp-server stdio
else
  echo "github-enterprise mcp: create 1Password item 'GitHub PAT (foodics)' (field: credential) holding a github.foodics.com PAT, then re-run 'chezmoi apply'." >&2
  hn github-enterprise skip "1Password PAT unavailable (op read empty/timed out)"
fi
{{ end -}}

exit 0
