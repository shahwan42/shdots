#!/bin/sh
# Reconciles Claude Code's user-scope MCP servers to the declarations below.
# Re-runs whenever this rendered script changes (chezmoi's run_onchange_
# semantics — no manual hash needed since the script IS the declaration).
#
# `claude mcp add` errors on a name that already exists, so each server is
# removed then re-added — that's what makes this idempotent.
set -u

# Structured history (see AGENTS.md "Fleet health"); no-op until applied.
HN="$HOME/.local/bin/chezmoi-health"
hn() { [ -x "$HN" ] && "$HN" note 40-claude-mcp-sync "$@" >/dev/null 2>&1 || :; }

CLAUDE="$(command -v claude || echo "$HOME/.local/share/mise/shims/claude")"
if ! command -v "$CLAUDE" >/dev/null 2>&1 && [ ! -x "$CLAUDE" ]; then
  echo "claude not found on PATH — skipping MCP server sync." >&2
  exit 0
fi

add() {
  name="$1"; shift
  "$CLAUDE" mcp remove "$name" --scope user >/dev/null 2>&1
  if "$CLAUDE" mcp add "$name" --scope user "$@" >/dev/null 2>&1; then
    echo "mcp: $name registered"
  else
    echo "mcp: $name registration failed" >&2
    hn "$name" fail "claude mcp add failed"
  fi
}

{{ if not (includeTemplate "has-personal" .) -}}
"$CLAUDE" mcp remove gmail --scope user >/dev/null 2>&1 || :
"$CLAUDE" mcp remove google-calendar --scope user >/dev/null 2>&1 || :
{{ end -}}

# Remove MCP servers retired from the shared declaration. GitHub goes through
# the gh CLI and databases through psql instead.
for _retired in shadcn-ui playwright github github-enterprise postgres; do
  "$CLAUDE" mcp remove "$_retired" --scope user >/dev/null 2>&1 || :
done

# --- shared everywhere (mac + vm, personal + work) ---
add context7 -- npx -y @upstash/context7-mcp
add citra -- npx -y @sylphx/citra

# Pin the validated binary release; installation never runs upstream main.
{{ includeTemplate "codebase-memory-install.sh" . }}
CBM_BIN="$HOME/.local/bin/codebase-memory-mcp"
if install_codebase_memory; then
  add codebase-memory-mcp -- "$CBM_BIN"
else
  echo "codebase-memory-mcp: pinned installation failed; re-run this script after fixing the reported error" >&2
  hn codebase-memory-mcp fail "pinned binary installation failed"
fi

exit 0
