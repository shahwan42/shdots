#!/bin/sh
# ~/AGENTS.md and ~/CLAUDE.md used to be rendered from this repo's own AGENTS.md
# and CLAUDE.md, so Claude (which loads every ancestor CLAUDE.md) pulled the
# dotfiles-maintenance instructions into every project under ~. Both are now
# repository-only (.chezmoiignore.tmpl), and ignored targets are left in place
# (.chezmoiremove skips them), so delete the stale copies here — only when they
# are recognisably the old rendered output; anything else is left alone.
set -u

HN="$HOME/.local/bin/chezmoi-health"
hn() { [ -x "$HN" ] && "$HN" note 48-ai-instructions-prune "$@" >/dev/null 2>&1 || :; }

f="$HOME/CLAUDE.md"
if [ -f "$f" ] && [ ! -L "$f" ]; then
  if [ "$(cat "$f")" = "@AGENTS.md" ]; then
    rm -f "$f" && echo "ai-instructions: removed stale ~/CLAUDE.md"
  else
    hn CLAUDE.md skip "~/CLAUDE.md is not the old rendered file; left in place"
  fi
fi

f="$HOME/AGENTS.md"
if [ -f "$f" ] && [ ! -L "$f" ]; then
  if [ "$(head -n 1 "$f")" = "# Dotfiles maintenance instructions" ]; then
    rm -f "$f" && echo "ai-instructions: removed stale ~/AGENTS.md"
  else
    hn AGENTS.md skip "~/AGENTS.md is not the old rendered file; left in place"
  fi
fi

exit 0
