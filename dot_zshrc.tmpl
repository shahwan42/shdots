# Interactive Zsh configuration managed by chezmoi.

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=50000
SAVEHIST=10000

setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify
setopt share_history

# zsh plugins are chezmoi-managed externals (same path on every machine).
ZSH_PLUGIN_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"

# Completion. Add plugin completions and Homebrew's site-functions (if present)
# to fpath before the single compinit call.
[[ -d "$ZSH_PLUGIN_DIR/zsh-completions/src" ]] && \
  fpath=("$ZSH_PLUGIN_DIR/zsh-completions/src" $fpath)
if [[ -n ${HOMEBREW_PREFIX:-} && -d "$HOMEBREW_PREFIX/share/zsh/site-functions" ]]; then
  fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
fi

autoload -Uz compinit
compinit

# Git aliases retained from observed use of the Oh My Zsh git plugin.
alias g='git'
alias ga='git add'
alias gc='git commit -v'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gd='git diff'
alias gl='git pull'
alias glo='git log --oneline --decorate'
alias gp='git push'
alias gst='git status'
alias gcp='git cherry-pick'
alias gbd='git branch -d'
alias gbD='git branch -D'
alias gts='git tag -s'
alias gsts='git stash show --text'

# Personal aliases.
alias n='nvim'
alias mp='multipass'
{{ if eq .role "work" }}
# Work aliases and environment.
alias a='php artisan'
alias sail='sh $([ -f sail ] && echo sail || echo vendor/bin/sail)'
export AWS_PROFILE=foodics_pay_export
{{ if eq .kind "mac" -}}
export JIRA_API_TOKEN="$(security find-generic-password -s jira-cli -a a.shahwan@foodics.com -w 2>/dev/null)"
{{ end -}}
{{ end }}
# Fuzzy repo jumper.
if (( $+commands[fzf] )) && (( $+commands[fd] )); then
  cw() {
    local repo
    repo=$(fd -HI -t d '^\.git$' ~/Code ~/code --max-depth 4 2>/dev/null \
          | sed 's|/\.git/$||' \
          | grep -v '/\.claude/worktrees/' | sort -u \
          | fzf --prompt='repo> ' --height=40% --reverse \
                --preview 'git -C {} log --oneline -8 --color=always' \
                --preview-window=right:50%) || return
    cd "$repo"
  }
fi
(( $+commands[eza] )) && alias ls='eza --color=always --icons=always'

# Interactive tools. Each guard keeps the same config portable to minimal VMs.
(( $+commands[zoxide] )) && eval "$(zoxide init zsh)"
if (( $+commands[fzf] )) && [[ -t 0 && -t 1 ]]; then
  source <(fzf --zsh)
fi
(( $+commands[mise] )) && eval "$(mise activate zsh)"
if (( $+commands[starship] )) && [[ ${TERM:-dumb} != dumb ]]; then
  eval "$(starship init zsh)"
fi

# mise can restore PATH entries inherited by its parent shell. Normalize once
# more after activation while migrating away from the retired installer.
path=(${path:#/Applications/SnowflakeCLI.app/Contents/MacOS/})
typeset -U path PATH

# UI plugins from the chezmoi-managed external dir. Syntax highlighting must
# remain the final sourced plugin.
[[ -r "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && \
  source "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh"
[[ -r "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
  source "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# 1Password CLI installs its static `_op` completion into Homebrew's
# site-functions directory, which compinit loaded above.

# Machine-local, unmanaged extras (secrets, one-off installs).
if [[ -r "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi
