# Interactive Zsh configuration managed by chezmoi.

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=100000
SAVEHIST=100000

setopt extended_history
setopt hist_expire_dups_first
setopt hist_ignore_dups
setopt hist_ignore_space
setopt hist_verify
setopt share_history

# Shared environment first — non-login shells (et, some terminals) skip
# zprofile, so re-source the same fragment it uses (idempotent: brew guard,
# typeset -U). Restores brew/EDITOR/JAVA_HOME/composer in et sessions, and
# makes the HOMEBREW_PREFIX fpath guard below work in every interactive mode.
[[ -r "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/env.zsh" ]] && \
  source "${XDG_CONFIG_HOME:-$HOME/.config}/zsh/env.zsh"

# mise next — everything below (aliases, completions, tool integrations) must
# see the mise-managed tools on PATH during this same sourcing pass.
(( $+commands[mise] )) && eval "$(mise activate zsh)"
{{ if eq .kind "vm" }}
# mise activate rebuilds PATH from __MISE_ORIG_PATH on every precmd, re-prepending
# the mermaid-cli install dir ahead of ~/.local/bin — bind the VM wrapper by name
# instead of relying on PATH order.
[[ -x "$HOME/.local/bin/mmdc" ]] && mmdc() { command "$HOME/.local/bin/mmdc" "$@"; }
{{ end }}

# zsh plugins are chezmoi-managed externals (same path on every machine).
ZSH_PLUGIN_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/zsh/plugins"

# Completion. Add plugin completions and Homebrew's site-functions (if present)
# to fpath before the single compinit call.
[[ -d "$ZSH_PLUGIN_DIR/zsh-completions/src" ]] && \
  fpath=("$ZSH_PLUGIN_DIR/zsh-completions/src" $fpath)
if [[ -n ${HOMEBREW_PREFIX:-} && -d "$HOMEBREW_PREFIX/share/zsh/site-functions" ]]; then
  fpath=("$HOMEBREW_PREFIX/share/zsh/site-functions" $fpath)
fi

autoload -Uz compinit
compinit

# Emacs keymap — Oh My Zsh did this in lib/key-bindings.zsh and the port
# dropped it. Without it zsh picks the keymap from $EDITOR/$VISUAL, and "nvim"
# matches zsh's `*vi*` test, so main aliases to viins and ^A/^E become
# self-insert instead of beginning/end-of-line. Must stay BEFORE the tool
# integrations below so fzf/zoxide/autosuggestions bind against emacs.
bindkey -e

# Git aliases retained from observed use of the Oh My Zsh git plugin.
alias g='git'
alias ga='git add'
alias gc='git commit -v'
alias gco='git checkout'
alias gcb='git checkout -b'
alias gd='git diff'
alias gl='git pull'
alias glo='git log --oneline --decorate'
alias gp='git push'
alias gst='git status'
alias gcp='git cherry-pick'
alias gbd='git branch -d'
alias gbD='git branch -D'
alias gts='git tag -s'
alias gsts='git stash show --text'

# Personal aliases.
alias n='nvim'
{{ if eq .kind "mac" }}alias mp='multipass'
{{ end -}}
{{ if eq .role "work" }}
# Work aliases and environment.
alias a='php artisan'
alias sail='sh $([ -f sail ] && echo sail || echo vendor/bin/sail)'
{{ if eq .kind "mac" -}}
# Export only on keychain success and non-empty: a failed security(1) call
# (ssh/et sessions with no keychain) must not export an empty token, which
# jira-cli would prefer over its own config and fail auth confusingly.
_jt="$(security find-generic-password -s jira-cli -a a.shahwan@foodics.com -w 2>/dev/null)" \
  && [[ -n $_jt ]] && export JIRA_API_TOKEN=$_jt
unset _jt
{{ end -}}
{{ end }}
# Fuzzy repo jumper.
if (( $+commands[fzf] )) && (( $+commands[fd] )); then
  cw() {
    local repo
    repo=$(fd -HI -t d '^\.git$' ~/Code ~/code --max-depth 4 2>/dev/null \
          | sed 's|/\.git/$||' \
          | grep -v '/\.claude/worktrees/' | sort -u \
          | fzf --prompt='repo> ' --height=40% --reverse \
                --preview 'git -C {} log --oneline -8 --color=always' \
                --preview-window=right:50%) || return
    cd "$repo"
  }
fi
(( $+commands[eza] )) && alias ls='eza --color=always --icons=always'

# Directory navigation (Oh My Zsh directories plugin). auto_cd makes a bare
# `..` / `../..` typed as a command cd there; auto_pushd keeps the dir stack
# for the numbered jumps.
setopt auto_cd auto_pushd pushd_ignore_dups pushdminus
alias -g ...='../..'
alias -g ....='../../..'
alias -g .....='../../../..'
alias -g ......='../../../../..'
alias -- -='cd -'
alias 1='cd -1'
alias 2='cd -2'
alias 3='cd -3'
alias 4='cd -4'
alias 5='cd -5'

# ls shortcuts (Oh My Zsh style; ride on the eza alias when present).
alias l='ls -lah'
alias ll='ls -lh'
alias la='ls -lAh'
alias lsa='ls -lah'

# Interactive tools. Each guard keeps the same config portable to minimal VMs.
# (mise was activated at the top of this file.)
(( $+commands[zoxide] )) && { eval "$(zoxide init zsh)"; alias j='z'; }
if (( $+commands[fzf] )) && [[ -t 0 && -t 1 ]]; then
  source <(fzf --zsh)
fi
if (( $+commands[starship] )) && [[ ${TERM:-dumb} != dumb ]]; then
  eval "$(starship init zsh)"
fi

typeset -U path PATH

# UI plugins from the chezmoi-managed external dir. Syntax highlighting must
# remain the final sourced plugin.
[[ -r "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh" ]] && \
  source "$ZSH_PLUGIN_DIR/zsh-autosuggestions/zsh-autosuggestions.zsh"
[[ -r "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ]] && \
  source "$ZSH_PLUGIN_DIR/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"

# 1Password CLI installs its static `_op` completion into Homebrew's
# site-functions directory, which compinit loaded above.

# Auto-update marker: the chezmoi-autoupdate timer writes this only when it
# could NOT safely fast-forward (divergence, local edits, failed apply). One
# stat() — zero startup cost when the fleet is converged.
[[ -f "$HOME/.cache/chezmoi-stale" ]] && cat "$HOME/.cache/chezmoi-stale" >&2

# Machine-local, unmanaged extras (secrets, one-off installs).
if [[ -r "$HOME/.zshrc.local" ]]; then
  source "$HOME/.zshrc.local"
fi
