#!/bin/sh
# Re-run whenever Brewfile.tmpl changes.
# Brewfile.tmpl hash: {{ include "Brewfile.tmpl" | sha256sum }}
set -u

{{ if and (eq .kind "mac") (or (eq .chezmoi.username "as") (includeTemplate "has-combined" .)) -}}
# tools present at render (reruns once a missing one appears): {{ includeTemplate "tools-present" (dict "home" .chezmoi.homeDir "tools" (list "brew")) }}
# chezmoi apply can run from a bare shell (autoupdate, first bootstrap).
PATH="/opt/homebrew/bin:${PATH:-/usr/bin:/bin}"
export PATH

if command -v brew >/dev/null 2>&1; then
  echo "Installing Homebrew packages from Brewfile…"
  BREWFILE_TMP="$(mktemp)"
  chezmoi execute-template "$(cat "{{ .chezmoi.sourceDir }}/Brewfile.tmpl")" >"$BREWFILE_TMP"
  brew bundle --file="$BREWFILE_TMP"
  rm -f "$BREWFILE_TMP"
fi
{{ end -}}
