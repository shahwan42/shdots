#!/bin/sh
# One-shot cleanup of AI config that the chezmoi-owned layout replaces. Runs
# after every managed file has been written, so the replacements exist first;
# each step also checks that before deleting anything, and leaves unrecognised
# content alone (logged as `skip` to chezmoi-health).
set -u

HN="$HOME/.local/bin/chezmoi-health"
hn() { [ -x "$HN" ] && "$HN" note 48-ai-legacy-prune "$@" >/dev/null 2>&1 || :; }

# 1. ~/AGENTS.md and ~/CLAUDE.md used to be rendered from this repo's own
#    AGENTS.md / CLAUDE.md, so Claude (which loads every ancestor CLAUDE.md)
#    pulled the dotfiles-maintenance instructions into every project under ~.
#    Both are repository-only now (.chezmoiignore.tmpl), and .chezmoiremove
#    skips ignored targets, so delete the stale copies here. Their only
#    universal content (the codebase-memory section) now lives in the shared
#    baseline; require the adapters to carry it before deleting.
BASELINE_MARK="## Codebase Knowledge Graph"
adapters_ok=1
for a in "$HOME/.claude/CLAUDE.md" "$HOME/.codex/AGENTS.md"; do
  grep -qF "$BASELINE_MARK" "$a" 2>/dev/null || adapters_ok=0
done

if [ "$adapters_ok" -ne 1 ]; then
  hn instructions skip "baseline adapters missing; kept ~/AGENTS.md and ~/CLAUDE.md"
else
  f="$HOME/CLAUDE.md"
  if [ -f "$f" ] && [ ! -L "$f" ]; then
    if [ "$(cat "$f")" = "@AGENTS.md" ]; then
      rm -f "$f" && echo "ai-legacy: removed stale ~/CLAUDE.md"
    else
      hn CLAUDE.md skip "~/CLAUDE.md is not the old rendered file; left in place"
    fi
  fi
  f="$HOME/AGENTS.md"
  if [ -f "$f" ] && [ ! -L "$f" ]; then
    if [ "$(head -n 1 "$f")" = "# Dotfiles maintenance instructions" ]; then
      rm -f "$f" && echo "ai-legacy: removed stale ~/AGENTS.md"
    else
      hn AGENTS.md skip "~/AGENTS.md is not the old rendered file; left in place"
    fi
  fi
fi

# 2. Codex reads both ~/.agents/skills and ~/.codex/skills, so a copy of
#    browser-harness in each lists the skill twice. ~/.agents/skills is the
#    canonical location (the browser-harness install writes it). Remove the
#    Codex-only copy only where the canonical one exists and the Codex copy is
#    a lone SKILL.md for the same skill.
canon="$HOME/.agents/skills/browser-harness/SKILL.md"
dup="$HOME/.codex/skills/browser-harness"
if [ -f "$canon" ] && [ -d "$dup" ] && [ ! -L "$dup" ]; then
  if [ "$(ls -A "$dup")" = "SKILL.md" ] && grep -q '^name: browser-harness$' "$dup/SKILL.md"; then
    rm -rf "$dup" && echo "ai-legacy: removed duplicate ~/.codex/skills/browser-harness"
  else
    hn codex-browser-harness skip "~/.codex/skills/browser-harness has extra files; left in place"
  fi
fi

exit 0
