{{- $workOnly := and (includeTemplate "has-work" .) (not (includeTemplate "has-personal" .)) -}}
[user]
{{ if $workOnly }}	email = a.shahwan@foodics.com
{{ else }}	email = a.shahwan42@gmail.com
{{ end }}	name = {{ if $workOnly }}A. S. Foodics{{ else }}Ahmed Shahwan{{ end }}
{{ if includeTemplate "has-git-signing" . }}	signingkey = {{ .chezmoi.homeDir }}/.ssh/{{ template "git-signing-key" . }}.pub
{{ end -}}
{{ if includeTemplate "has-combined" . -}}
# One account, two identities: repositories whose remote is on GitHub
# Enterprise get the work identity. Matching the remote (not the path) also
# covers Worktrunk worktrees, which share their repository's config.
[includeIf "hasconfig:remote.*.url:git@github.foodics.com:*/**"]
	path = {{ .chezmoi.homeDir }}/.config/git/work.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.foodics.com/**"]
	path = {{ .chezmoi.homeDir }}/.config/git/work.gitconfig
{{ end -}}
[core]
	editor = nvim
	excludesfile = {{ .chezmoi.homeDir }}/.gitignore_global
	pager = delta
[init]
	defaultBranch = main
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	hyperlinks = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
{{ if eq .kind "mac" }}[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =
[mergetool "sourcetree"]
	cmd = {{ .chezmoi.homeDir }}/Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
{{ end -}}
[commit]
	gpgsign = {{ if includeTemplate "has-git-signing" . }}true{{ else }}false{{ end }}
[gpg]
	format = ssh
[gpg "ssh"]
	allowedSignersFile = {{ .chezmoi.homeDir }}/.config/git/allowed_signers
