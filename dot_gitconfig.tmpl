[user]
{{ if eq .role "work" }}	email = a.shahwan@foodics.com
{{ else }}	email = a.shahwan42@gmail.com
{{ end }}	name = Ahmed Shahwan
{{ if eq .kind "mac" }}	signingkey = 5E6FDBD5F9D11C70
{{ end }}[core]
	editor = nvim
	excludesfile = {{ .chezmoi.homeDir }}/.gitignore_global
	pager = delta
[init]
	defaultBranch = main
[pull]
	rebase = false
[push]
	autoSetupRemote = true
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[interactive]
	diffFilter = delta --color-only
[delta]
	navigate = true
	line-numbers = true
	side-by-side = true
	hyperlinks = true
[merge]
	conflictstyle = zdiff3
[diff]
	colorMoved = default
{{ if eq .kind "mac" }}[difftool "sourcetree"]
	cmd = opendiff \"$LOCAL\" \"$REMOTE\"
	path =
[mergetool "sourcetree"]
	cmd = {{ .chezmoi.homeDir }}/Applications/Sourcetree.app/Contents/Resources/opendiff-w.sh \"$LOCAL\" \"$REMOTE\" -ancestor \"$BASE\" -merge \"$MERGED\"
	trustExitCode = true
[commit]
	gpgsign = true
[gpg]
	format = openpgp
{{ end -}}
