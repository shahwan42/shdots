<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.shahwan42.chezmoi-update</string>
	<key>ProgramArguments</key>
	<array>
		<string>{{ .chezmoi.homeDir }}/.local/bin/chezmoi-autoupdate</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<!-- launchd's default PATH is /usr/bin:/bin:/usr/sbin:/sbin, which hides
		     gpg (GitHub web-flow merge signatures), timeout, brew and the agent
		     CLIs from the updater and every run script it triggers. -->
		<key>PATH</key>
		<string>{{ .chezmoi.homeDir }}/.local/share/mise/shims:{{ .chezmoi.homeDir }}/.local/bin:/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
	</dict>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>21600</integer>
	<key>StandardErrorPath</key>
	<string>{{ .chezmoi.homeDir }}/.cache/chezmoi-autoupdate.log</string>
	<key>StandardOutPath</key>
	<string>{{ .chezmoi.homeDir }}/.cache/chezmoi-autoupdate.log</string>
</dict>
</plist>
