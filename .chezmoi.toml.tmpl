{{- $kind := promptChoiceOnce . "kind" "Machine kind" (list "mac" "vm") -}}
{{- $username := .chezmoi.username -}}
{{- $role := "" -}}
{{- if and (eq $kind "mac") (eq $username "as") -}}
{{-   $role = "personal" -}}
{{- else if and (eq $kind "mac") (eq $username "foodics") -}}
{{-   $role = "work" -}}
{{- else -}}
{{-   $role = promptChoiceOnce . "role" "Account role" (list "personal" "work") -}}
{{- end -}}
{{- $hostname := promptStringOnce . "hostname" "Machine hostname" (output "hostname" "-s" | trim) -}}
{{- $eod := false -}}
{{- if eq $role "work" -}}
{{-   $eod = promptBoolOnce . "eod" "Install eod skill" false -}}
{{- end -}}
{{- $signingDefault := eq $kind "vm" -}}
{{- if and (eq $role "personal") (stat (joinPath .chezmoi.homeDir ".ssh/id_ed25519.pub")) -}}
{{-   $signingDefault = true -}}
{{- end -}}
# Native accounts never receive the fleet age key or shared service token.
# Encryption is retained for legacy compatibility VMs; native encrypted targets
# are excluded in .chezmoiignore.tmpl even if a key is already present.
umask = 0o022

{{ if eq $kind "vm" -}}
encryption = "age"
[age]
    identity = {{ (joinPath .chezmoi.homeDir ".config/chezmoi/key.txt") | quote }}
    recipient = "age1ax3esnk3kmyaqaemwd4kxlzm265yc00stqqmp64mvqtexuqxvsks7ac5xe"
{{ end -}}
[data]
kind = {{ $kind | quote }}
# hostname is the existing repository name for the physical machine identity.
hostname = {{ $hostname | quote }}
username = {{ $username | quote }}
role = {{ $role | quote }}
eod = {{ $eod }}
# Native onboarding is manual. Enable updates only after account-local review.
auto_update = {{ dig "auto_update" (eq $kind "vm") . }}
# Existing personal consumers remain available; work auth is provisioned later.
secret_integrations = {{ dig "secret_integrations" (eq $role "personal") . }}
# Public key presence preserves existing personal signing; a new account can
# commit before keys are created. Enabling signing later is an explicit step.
git_signing = {{ dig "git_signing" $signingDefault . }}
