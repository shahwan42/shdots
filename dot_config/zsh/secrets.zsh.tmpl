# Managed by chezmoi. Shell tokens from 1Password, sourced by ~/.zshrc before
# ~/.zshrc.local (which may still override any of them).
#
# Items are referenced by UUID (titles get renamed; UUIDs don't) and no secret
# value ever lives in this repo. A bare `op read` is a network round-trip, and
# on a Mac reached over ssh/et it can stall, so values are cached on disk
# (0600, ${XDG_CACHE_HOME:-~/.cache}/op-secrets/<VAR>) and refreshed in parallel,
# 3s-capped, only when older than an hour. A failed refresh keeps the last good
# value; an empty one is never exported.
#
# Variable names deliberately avoid GITHUB_TOKEN / GH_ENTERPRISE_TOKEN: gh gives
# those precedence over its stored login, so exporting them would silently
# downgrade gh to whatever token is here.
#   GITHUB_READONLY_TOKEN  github.com, public read-only   (OpenCode github MCP)
#   MISE_GITHUB_TOKEN      same token, for mise's github:/ubi:/aqua backends
#   GHE_MCP_TOKEN          github.foodics.com             (OpenCode github-enterprise MCP)
#   JIRA_API_TOKEN         jira-cli
#   SONAR_TOKEN            sonar-scanner
#   GH_TOKEN               github.com write, personal VMs only: gh has no stored
#                          login there, so this is its credential

typeset -A _op_secret_refs
_op_secret_refs=(
  GITHUB_READONLY_TOKEN 'op://dev-secrets/jypxoxjttljurjhg3f72bvlx6e/token'
{{- if includeTemplate "has-work" . }}
  GHE_MCP_TOKEN         'op://dev-secrets/i4fkk5sxnoihinvcnv2evqg7be/credential'
  JIRA_API_TOKEN        'op://dev-secrets/cuhmbyox773pricvf6xmm5nfba/credential'
  SONAR_TOKEN           'op://dev-secrets/vxwnzlffnicehkjjd5jjmg63xe/credential'
{{- end }}
{{- if and (eq .kind "vm") (eq .role "personal") }}
  GH_TOKEN              'op://dev-secrets/xwug424pq6bcit35v5abzpt5vm/credential'
{{- end }}
)

() {
  emulate -L zsh
  setopt local_options no_monitor no_notify
  local dir="${XDG_CACHE_HOME:-$HOME/.cache}/op-secrets" var file
  local -a stale old
  local timeout_cmd
  (( $+commands[timeout] )) && timeout_cmd=timeout
  (( $+commands[gtimeout] )) && timeout_cmd=gtimeout
  mkdir -p "$dir" 2>/dev/null && chmod 700 "$dir" 2>/dev/null

  # Stale = missing, empty, or older than 60 minutes (zsh glob qualifier mh+59).
  for var in ${(k)_op_secret_refs}; do
    file="$dir/$var"
    old=($file(Nmh+59))
    [[ -s $file ]] && (( ! ${#old} )) || stale+=($var)
  done

  # Refresh stale entries in parallel. No timeout binary or no op: keep cache.
  if (( ${#stale} )) && [[ -n $timeout_cmd ]] && (( $+commands[op] )); then
    for var in $stale; do
      file="$dir/$var"
      { $timeout_cmd 3 op read "${_op_secret_refs[$var]}" >"$file.tmp" 2>/dev/null \
          && [[ -s $file.tmp ]] && chmod 600 "$file.tmp" && mv -f "$file.tmp" "$file" } \
        || rm -f "$file.tmp" &
    done
    wait
  fi

  for var in ${(k)_op_secret_refs}; do
    file="$dir/$var"
    if [[ -s $file ]]; then
      export "$var=$(<$file)"
    else
      unset "$var"
    fi
  done
  [[ -n ${GITHUB_READONLY_TOKEN:-} ]] && export MISE_GITHUB_TOKEN="$GITHUB_READONLY_TOKEN"
}
unset _op_secret_refs
