# kitty — local overrides.
#
# kitty.conf is kept as the pristine upstream reference; its last line is
# `include kitty-local.conf`, so everything here wins. This is the file to edit,
# and the one that carries per-machine branches — same pattern as
# dot_config/ghostty/config.tmpl.

# --- shared ---
font_size 15.0
modify_font cell_height 160% # -2px
# kitty rounds the cell width up (Menlo 15pt = 18.06px -> 19px); 95% matches Ghostty's 18px.
modify_font cell_width 95%
remember_window_size  yes
draw_minimal_borders yes
window_margin_width 1
placement_strategy center
hide_window_decorations yes
auto_reload_config 1
enabled_layouts splits,tall,stack

# New windows (including splits) inherit the active window's working directory.
map kitty_mod+enter new_window_with_cwd
map cmd+enter       new_window_with_cwd

# Zoom like Ghostty: 1pt steps, current OS window only (kitty default is 2pt, all windows).
map cmd+equal       change_font_size current +1.0
map cmd+plus        change_font_size current +1.0
map shift+cmd+equal change_font_size current +1.0
map cmd+minus       change_font_size current -1.0
map shift+cmd+minus change_font_size current -1.0
map cmd+0           change_font_size current 0

# ported from ghostty (dot_config/ghostty/config.tmpl).
# kitty has no inline comments -- keep notes on their own lines.

# ghostty: no font-thicken. kitty's default `platform` strategy on macOS
# (gamma 1.7, contrast 30%) renders heavier; linear with no boost stays light.
text_composition_strategy 1.0 0
# ghostty: background-opacity = 0.85
background_opacity 0.85
# ghostty: background-blur = true (kitty wants a radius; ~20 approximates it)
background_blur 20
# ghostty: window-padding-x/y = 8 (edge->content; window_margin_width is the gap between splits)
window_padding_width 8
# ghostty: confirm-close-surface = true (kitty confirms on os-window close only, not per-split)
confirm_os_window_close 1
# ghostty: unfocused-split-opacity = 0.6 (kitty dims inactive text, not the whole pane)
inactive_text_alpha 0.6
# ghostty: split-divider-color = #3f444a
active_border_color #61afef
inactive_border_color #3f444a
# ghostty: tabs sit at the top on macOS
tab_bar_edge top
tab_bar_style separator
tab_separator " ┇"
tab_activity_symbol "●"
