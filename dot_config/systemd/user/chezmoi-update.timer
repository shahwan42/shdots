[Unit]
Description=Run chezmoi auto-update every 6 hours

[Timer]
OnBootSec=5min
# Wall-clock schedule (not monotonic) so Persistent=true can actually run a
# missed tick at next boot; the randomized delay de-thunders the fleet.
OnCalendar=*-*-* 00/6:00:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
