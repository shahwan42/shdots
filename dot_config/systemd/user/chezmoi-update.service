[Unit]
Description=chezmoi auto-update (safe fast-forward only)

[Service]
Type=oneshot
# Backstop for a wedged network fetch/apply; the script also bounds its own
# git fetch, this catches everything else.
TimeoutStartSec=15min
# The user manager's default PATH has neither mise shims nor ~/.local/bin, so
# run scripts would skip the agent CLIs and herdr.
Environment=PATH=%h/.local/share/mise/shims:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/.local/bin/chezmoi-autoupdate
